+            pm._run_git_text(
+                [
+                    "commit",
+                    "-m",
+                    f"chore: sync metadata alignment to {latest_a_id[:8]}",
+                ],
+                state["repo_b_dir"],
+            )
+
+        # 4. 执行真正的推送
+        pm.push_to_remote()
+
+        return {
+            "status": "completed",
+            "logs": logs + [f"🚀 最终同步完成，已对齐至 {latest_a_id[:8]}"],
+        }
+    except Exception as e:
+        return {"status": "error", "logs": state["logs"] + [f"❌ 推送失败: {str(e)}"]}
