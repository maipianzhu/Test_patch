+        dm.save_metadata(latest_a_id)
+
+        # 3. 提交元数据变更 (如果存在)
+        pm._run_git_text(["add", ".sync_metadata.json"], state["repo_b_dir"])
+        status_out = pm._run_git_text(["status", "--porcelain"], state["repo_b_dir"])
